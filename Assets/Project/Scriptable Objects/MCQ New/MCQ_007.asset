  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_007
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: What will happen if meiosis fails to occur during gamete formation?
  referenceImage: {fileID: 0}
  explanationText: Meiosis is critical for keeping the number of chromosomes constant
    through one generation to the next generation by reducing the chromosome number
    to half in gametes.
  options:
  - No significant effect on the next generation.
  - Number of chromosomes will decrease in the next generation.
  - Number of chromosomes will remain same in the next generation.
  - Number of chromosomes will increase in the next generation.
  correctOptionIndex: 3
